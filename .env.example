# Google Apps Script web app deployment URL and shared server-side key
APPS_SCRIPT_URL=https://script.google.com/macros/s/your-deployment-id/exec
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/your-deployment-id/exec
APPS_SCRIPT_KEY=replace-with-a-long-random-secret
GOOGLE_APPS_SCRIPT_KEY=replace-with-a-long-random-secret

# Server-only Razorpay API credentials
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Public checkout key ID (never put the key secret here)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
